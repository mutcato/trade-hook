SECRET_KEY=
DEBUG=
ENVIRONMENT=
CUSTOMER=

ACCESS_TOKEN_LIFETIME=
REFRESH_TOKEN_LIFETIME=

## Development
POSTGRES_CONNECTION_STRING=postgresql://user:pass@127.0.0.1:5432/tradehook
REDIS_URL=
TELEGRAM_BOT_NAME=
TELEGRAM_BOT_TOKEN=

## Billing — execution credits
# Lifetime free executions per account before a top-up is required.
FREE_EXECUTION_QUOTA=3
# Used to build the provider's success/cancel return URLs.
FRONTEND_BASE_URL=http://127.0.0.1:5173

## NOWPayments (https://nowpayments.io)
# From Dashboard → Settings → Payments → API keys.
NOWPAYMENTS_API_KEY=
# From Dashboard → Settings → Payments → IPN; signs the callback body.
NOWPAYMENTS_IPN_SECRET=
# Keep true against api-sandbox.nowpayments.io until the flow is verified.
NOWPAYMENTS_SANDBOX=true
# Must be publicly reachable — NOWPayments calls it server-to-server.
# Locally, expose it with a tunnel, e.g. https://<subdomain>.ngrok.app/api/billing/nowpayments/ipn/
NOWPAYMENTS_IPN_CALLBACK_URL=
# Locks the invoice to one asset, so it does not open on BTC. Must be a ticker
# the account can actually receive, e.g. usdtsol (USDT on Solana), usdttrc20
# (USDT on TRON). Leave empty to let the customer pick any supported coin.
NOWPAYMENTS_PAY_CURRENCY=usdtsol

TRADINGVIEW_REFERENCE_LINK="https://www.tradingview.com/pricing/?share_your_love=mtokat1"
